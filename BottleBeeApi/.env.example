# ---------------------------------------------------------------------------
# Bottle Bee API — environment template. Copy to `.env` and fill in real values.
# Never commit a populated .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bottle_bee
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_LOGGING=false

# Separate database used by `npm test`. Must NOT be the development database.
DB_NAME_TEST=bottle_bee_test

# --- JWT --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=bottlebee

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:4200

# --- Payments ---------------------------------------------------------------
# PAYMENT_PROVIDER: RAZORPAY | MOCK
# MOCK keeps checkout runnable locally without provider credentials.
PAYMENT_PROVIDER=MOCK
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5

# --- Security ---------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=30

# --- Rate limits (requests per window) --------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_MAX=20

# --- Compliance defaults ----------------------------------------------------
DEFAULT_REGION_CODE=IN-TS
DEFAULT_MINIMUM_AGE=21

# --- Fulfilment -------------------------------------------------------------
# Flat delivery fee, waived once the discounted subtotal reaches the threshold.
DELIVERY_FEE=49
FREE_DELIVERY_ABOVE=1500
# How long an untouched cart stays claimable before it is marked abandoned.
CART_EXPIRY_HOURS=72
# Grace period in which a customer may still cancel a confirmed order.
CANCELLATION_WINDOW_MINUTES=5

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs

# --- Super admin bootstrap (used by seeders only) ---------------------------
SUPER_ADMIN_EMAIL=admin@bottlebee.in
SUPER_ADMIN_PASSWORD=ChangeMe@12345
SUPER_ADMIN_PHONE=+919000000001
